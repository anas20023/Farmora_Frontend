# Application and Better Auth
BETTER_AUTH_SECRET=replace-with-a-long-random-secret
BETTER_AUTH_URL=http://localhost:3000
DB_URL=postgres://username:password@localhost:5432/farmora

# Farmora application API (use http://localhost:5000/api/v1 for local API development)
NEXT_PUBLIC_API_BASE_URL=https://api.farmora.anasi.me/api/v1

# Google OAuth (optional)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Gmail SMTP: use a Google App Password, never your normal Gmail password.
SMTP_USER=
SMTP_PASS=
# Optional. Defaults to "Farmora" <SMTP_USER> when omitted.
SMTP_FROM=
